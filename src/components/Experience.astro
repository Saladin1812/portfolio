---
const experiences = [
  {
    role: "App Developer",
    company: "PrimeX Meta",
    period: "Oct 2025 — Present",
    location: "Remote",
    achievements: [
      "Creating mobile applications with Flutter, Expo, Avalonia and other frameworks",
      "Integrating APIs, optimizing backends for applications",
      "Working / engaging with companies including Krypsm",
    ],
  },
  {
    role: "Discord / Telegram Bots & Server Setups",
    company: "Freelance",
    period: "Jan 2022 — Oct 2025",
    location: "Remote",
    achievements: [
      "Working with individuals and organisations to setup chat bots including payment systems, AI integrations and more",
      "Using Hikari, Hikari-Crescent and Python to create discord bots",
      "Hosting game servers like Minecraft, CLI automation tools for easy server deployment",
    ],
  },
  {
    role: "Content Creator",
    company: "YouTube & Blogs",
    period: "Sep 2023 — Present",
    location: "Online",
    achievements: [
      "Creating blogs and content on Tech including Languages, Containerization, DevOps, Linux",
      "YouTube channel and blog at blog.saladin.pro",
      "Game dev articles and guides focusing on Linux development & deployment",
    ],
  },
  {
    role: "QA Automation Engineer",
    company: "Murena (e.foundation)",
    period: "Feb 2021 — Oct 2021",
    location: "Remote",
    achievements: [
      "Web automation testing using Selenium & Selenium Base",
      "Manual automation testing of Android Apps on e/OS ROMs",
      "GitLab CI/CD setup for running automated tests",
    ],
  },
];
---

<section id="experience" class="section-fade px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <div class="reveal reveal-up">
      <p class="font-mono text-sm text-accent">// experience</p>
      <h2 class="mt-2 font-mono text-3xl font-bold text-text">
        Work Experience
      </h2>
    </div>

    <div class="relative mt-10">
      <!-- Timeline line -->
      <div
        class="absolute left-0 top-0 hidden h-full w-px bg-border md:left-8 md:block"
      >
      </div>

      <div class="space-y-8">
        {
          experiences.map((exp, i) => (
            <div
              class={`reveal reveal-left stagger-${Math.min(i + 1, 4)} relative md:pl-20`}
            >
              {/* Timeline dot */}
              <div class="absolute left-[29px] top-6 hidden h-3 w-3 rounded-full border-2 border-accent bg-bg md:block" />

              <div class="rounded-xl border border-border bg-card p-6 transition-all hover:border-accent/20 hover:bg-card-hover">
                <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-start">
                  <div>
                    <h3 class="font-mono text-base font-medium text-text">
                      {exp.role}
                    </h3>
                    <p class="mt-1 text-sm text-accent">{exp.company}</p>
                  </div>
                  <div class="flex items-center gap-3 text-xs text-text-muted">
                    <span class="font-mono">{exp.period}</span>
                    <span class="hidden sm:inline">·</span>
                    <span class="hidden sm:inline">{exp.location}</span>
                  </div>
                </div>
                <ul class="mt-4 space-y-2">
                  {exp.achievements.map((a) => (
                    <li class="flex gap-2 text-sm text-text-secondary">
                      <span class="mt-1.5 h-1 w-1 flex-shrink-0 rounded-full bg-accent/60" />
                      {a}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
