---
const contributions = [
  {
    name: "Lutris",
    description:
      "Open gaming platform for Linux. Helps you install and play video games from all eras and from most gaming systems.",
    tech: ["Python", "Shell"],
    github: "https://github.com/lutris/lutris",
  },
  {
    name: "Bevy",
    description:
      "A refreshingly simple data-driven game engine built in Rust. Free and Open Source Forever!",
    tech: ["Rust"],
    github: "https://github.com/bevyengine/bevy",
  },
  {
    name: "alis",
    description:
      "Arch Linux Install Script — installs an unattended, automated and customized Arch Linux system.",
    tech: ["Shell"],
    github: "https://github.com/picodotdev/alis",
  },
  {
    name: "kanagawa.nvim",
    description:
      "NeoVim dark colorscheme inspired by the colors of the famous painting by Katsushika Hokusai.",
    tech: ["Lua"],
    github: "https://github.com/rebelot/kanagawa.nvim",
  },
];
---

<section id="open-source" class="section-fade px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <div class="reveal reveal-up">
      <p class="font-mono text-sm text-accent">// open-source</p>
      <h2 class="mt-2 font-mono text-3xl font-bold text-text">
        Open Source Contributions
      </h2>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        contributions.map((contrib, i) => (
          <a
            href={contrib.github}
            target="_blank"
            rel="noopener noreferrer"
            class={`reveal reveal-right stagger-${Math.min(i + 1, 4)} group flex items-start gap-4 rounded-xl border border-border bg-card p-5 transition-all hover:border-accent/30 hover:bg-card-hover`}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mt-0.5 flex-shrink-0 text-accent"
            >
              <circle cx="12" cy="18" r="3" />
              <circle cx="6" cy="6" r="3" />
              <circle cx="18" cy="6" r="3" />
              <path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9" />
              <path d="M12 12v3" />
            </svg>
            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between gap-2">
                <h3 class="truncate font-mono text-sm font-medium text-text">
                  {contrib.name}
                </h3>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="flex-shrink-0 text-text-muted transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
                >
                  <path d="M7 7h10v10" />
                  <path d="M7 17 17 7" />
                </svg>
              </div>
              <p class="mt-1 text-xs leading-relaxed text-text-muted">
                {contrib.description}
              </p>
              <div class="mt-2 flex gap-2">
                {contrib.tech.map((t) => (
                  <span class="rounded bg-accent/10 px-1.5 py-0.5 font-mono text-[10px] text-accent">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
