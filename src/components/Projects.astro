---
const projects = [
  {
    title: "Eeman",
    description:
      "An application to get Salah (Prayer) timings and read the beautiful Quran with Saheeh International translation.",
    tech: ["Python", "GTK 4", "Libadwaita"],
    github: "https://github.com/Saladin1812/Eeman",
  },
  {
    title: "dotfiles",
    description:
      "My personal NixOS & Hyprland dotfiles. Declarative system configuration and development environment.",
    tech: ["Nix", "Lua", "Shell"],
    github: "https://github.com/Saladin1812/dotfiles",
  },
  {
    title: "Lutris-RHEL-CentOS-8",
    description:
      "Lutris RPM package for Enterprise Linux 8. Making Linux gaming accessible on RHEL-based distributions.",
    tech: ["RPM Spec", "Shell"],
    github: "https://github.com/Saladin1812/Lutris-RHEL-CentOS-8",
  },
];
---

<section id="projects" class="section-fade px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <div class="reveal reveal-scale">
      <p class="font-mono text-sm text-accent">// projects</p>
      <h2 class="mt-2 font-mono text-3xl font-bold text-text">Projects</h2>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, i) => (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class={`reveal reveal-scale stagger-${i + 1} group rounded-xl border border-border bg-card p-6 transition-all hover:border-accent/30 hover:bg-card-hover`}
          >
            <div class="flex items-start justify-between">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-accent"
              >
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-text-muted transition-transform group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-accent"
              >
                <path d="M7 7h10v10" />
                <path d="M7 17 17 7" />
              </svg>
            </div>

            <h3 class="mt-4 font-mono text-base font-medium text-text">
              {project.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">
              {project.description}
            </p>

            <div class="mt-4 flex flex-wrap gap-2">
              {project.tech.map((t) => (
                <span class="rounded-md bg-accent/10 px-2 py-0.5 font-mono text-xs text-accent">
                  {t}
                </span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
