---
const contactInfo = [
  {
    label: "Email",
    value: "contact@saladin.pro",
    href: "mailto:contact@saladin.pro",
    icon: `<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>`,
  },
  {
    label: "Location",
    value: "Noida, India",
    href: null,
    icon: `<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>`,
  },
];
---

<section id="contact" class="section-fade px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <div class="reveal reveal-up">
      <p class="font-mono text-sm text-accent">// contact</p>
      <h2 class="mt-2 font-mono text-3xl font-bold text-text">Get In Touch</h2>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      <!-- Contact info -->
      <div class="reveal reveal-left stagger-1">
        <p class="leading-relaxed text-text-secondary">
          Have a project in mind, need a server setup, or just want to chat?
          Feel free to reach out. I'm always open to new opportunities and
          collaborations.
        </p>

        <div class="mt-6 space-y-4">
          {
            contactInfo.map((info) => (
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg border border-border bg-card">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="text-accent"
                    set:html={info.icon}
                  />
                </div>
                <div>
                  <p class="text-xs text-text-muted">{info.label}</p>
                  {info.href ? (
                    <a
                      href={info.href}
                      class="font-mono text-sm text-text transition-colors hover:text-accent"
                    >
                      {info.value}
                    </a>
                  ) : (
                    <p class="font-mono text-sm text-text">{info.value}</p>
                  )}
                </div>
              </div>
            ))
          }
        </div>

        <!-- Social links row -->
        <div class="mt-8 flex gap-3">
          <a
            href="https://github.com/Saladin1812"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-card text-text-secondary transition-all hover:border-accent hover:text-accent"
            aria-label="GitHub"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
              ></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>
          <a
            href="https://twitter.com/Saladin1812"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-card text-text-secondary transition-all hover:border-accent hover:text-accent"
            aria-label="Twitter"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 4l11.733 16H20L8.267 4z"></path>
              <path d="m4 20 6.768-6.768M15.232 10.768 20 4"></path>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/in/salahuddin-ayyub-852531352/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-card text-text-secondary transition-all hover:border-accent hover:text-accent"
            aria-label="LinkedIn"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
              ></path>
              <rect width="4" height="12" x="2" y="9"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a
            href="https://discord.com/users/489575472024256512"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-card text-text-secondary transition-all hover:border-accent hover:text-accent"
            aria-label="Discord"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M9.09 9a3 3 0 0 0-2.83 2M12.91 9a3 3 0 0 1 2.83 2M7.5 15.5c1.5 1 3.5 1.5 4.5 1.5s3-0.5 4.5-1.5M19.73 5.06A17 17 0 0 0 15.5 4c-.2.4-.5 1-.7 1.4A16.5 16.5 0 0 0 9.2 5.4c-.2-.5-.4-1-.7-1.4a17 17 0 0 0-4.23 1.06C1.27 9.56.5 14 1 18.4A17.1 17.1 0 0 0 6.3 21a12 12 0 0 0 1.1-1.8 11 11 0 0 1-1.7-.8l.4-.3a12.2 12.2 0 0 0 10.4 0l.4.3a11 11 0 0 1-1.7.8 12 12 0 0 0 1.1 1.8A17.1 17.1 0 0 0 21.5 18.4c.5-5.3-.9-9.8-3.77-13.34Z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Contact form -->
      <div class="reveal reveal-right stagger-2">
        <form
          action="https://formspree.io/f/xwpoyjaw"
          method="POST"
          class="space-y-4"
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block font-mono text-xs text-text-muted"
                >Name</label
              >
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full rounded-lg border border-border bg-card px-4 py-2.5 text-sm text-text placeholder-text-muted outline-none transition-colors focus:border-accent"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="email" class="mb-1.5 block font-mono text-xs text-text-muted"
                >Email</label
              >
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full rounded-lg border border-border bg-card px-4 py-2.5 text-sm text-text placeholder-text-muted outline-none transition-colors focus:border-accent"
                placeholder="you@example.com"
              />
            </div>
          </div>
          <div>
            <label for="subject" class="mb-1.5 block font-mono text-xs text-text-muted"
              >Subject</label
            >
            <input
              type="text"
              id="subject"
              name="subject"
              required
              class="w-full rounded-lg border border-border bg-card px-4 py-2.5 text-sm text-text placeholder-text-muted outline-none transition-colors focus:border-accent"
              placeholder="What's this about?"
            />
          </div>
          <div>
            <label for="message" class="mb-1.5 block font-mono text-xs text-text-muted"
              >Message</label
            >
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="w-full resize-none rounded-lg border border-border bg-card px-4 py-2.5 text-sm text-text placeholder-text-muted outline-none transition-colors focus:border-accent"
              placeholder="Your message..."></textarea>
          </div>
          <button
            type="submit"
            class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-2.5 font-mono text-sm font-medium text-bg transition-colors hover:bg-accent-hover"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path>
              <path d="m21.854 2.147-10.94 10.939"></path>
            </svg>
            Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
