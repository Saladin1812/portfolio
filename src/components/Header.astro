---
const navLinks = [
  { href: "#home", label: "Home" },
  { href: "#about", label: "About" },
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Projects" },
  { href: "#blog", label: "Blog" },
  { href: "#contact", label: "Contact" },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
  >
    <a
      href="#home"
      class="font-mono text-lg font-bold text-accent transition-colors hover:text-accent-hover"
    >
      ~/saladin
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-8 md:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="link-underline font-mono text-sm text-text-secondary transition-colors hover:text-accent"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="flex flex-col gap-1.5 md:hidden"
      aria-label="Toggle menu"
    >
      <span class="block h-0.5 w-6 bg-text-secondary transition-all duration-300"></span>
      <span class="block h-0.5 w-6 bg-text-secondary transition-all duration-300"></span>
      <span class="block h-0.5 w-4 bg-text-secondary transition-all duration-300"></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-b border-border bg-surface/95 backdrop-blur-md md:hidden"
  >
    <ul class="flex flex-col gap-1 px-6 py-4">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-nav-link block rounded-lg px-4 py-2.5 font-mono text-sm text-text-secondary transition-colors hover:bg-card hover:text-accent"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById("site-header")!;
  const menuBtn = document.getElementById("mobile-menu-btn")!;
  const mobileMenu = document.getElementById("mobile-menu")!;
  const spans = menuBtn.querySelectorAll("span");

  let menuOpen = false;

  // Scroll effect
  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      header.classList.add(
        "bg-surface/80",
        "backdrop-blur-md",
        "border-b",
        "border-border"
      );
    } else {
      header.classList.remove(
        "bg-surface/80",
        "backdrop-blur-md",
        "border-b",
        "border-border"
      );
    }
  });

  // Mobile menu toggle
  menuBtn.addEventListener("click", () => {
    menuOpen = !menuOpen;
    mobileMenu.classList.toggle("hidden");

    if (menuOpen) {
      spans[0].style.transform = "rotate(45deg) translate(4px, 4px)";
      spans[1].style.opacity = "0";
      spans[2].style.transform = "rotate(-45deg) translate(4px, -4px)";
      spans[2].style.width = "24px";
    } else {
      spans[0].style.transform = "";
      spans[1].style.opacity = "1";
      spans[2].style.transform = "";
      spans[2].style.width = "16px";
    }
  });

  // Close mobile menu on link click
  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.add("hidden");
      menuOpen = false;
      spans[0].style.transform = "";
      spans[1].style.opacity = "1";
      spans[2].style.transform = "";
      spans[2].style.width = "16px";
    });
  });
</script>
