---

<section
  id="home"
  class="relative flex min-h-screen items-center justify-center px-6 pt-20"
>
  <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2">
    <!-- Text content -->
    <div class="order-2 md:order-1">
      <p
        class="reveal reveal-left font-mono text-sm text-accent"
      >
        $ whoami
      </p>
      <h1
        class="reveal reveal-left stagger-1 mt-3 font-mono text-4xl font-bold leading-tight text-text md:text-5xl lg:text-6xl"
      >
        Saladin
      </h1>
      <p
        class="reveal reveal-left stagger-2 mt-2 font-mono text-lg text-text-secondary md:text-xl"
      >
        Software Engineer<span class="cursor-blink text-accent">_</span>
      </p>
      <p
        class="reveal reveal-up stagger-3 mt-6 max-w-lg leading-relaxed text-text-secondary"
      >
        Building Software, Games, Contributing to FOSS, Tinkering with Systems
        and Reading Docs. Specializing in
        <span class="text-text">Rust</span>,
        <span class="text-text">Kotlin</span>,
        <span class="text-text">C++</span>,
        <span class="text-text">Go</span>,
        <span class="text-text">Zig</span> &
        <span class="text-text">Odin</span>.
      </p>

      <!-- Social links -->
      <div class="reveal reveal-up stagger-4 mt-8 flex flex-wrap gap-3">
        {
          socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              class="group flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-card transition-all hover:border-accent hover:bg-card-hover"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-text-secondary transition-colors group-hover:text-accent"
                set:html={social.icon}
              />
            </a>
          ))
        }
      </div>

      <!-- CTA -->
      <div class="reveal reveal-up stagger-5 mt-8 flex gap-4">
        <a
          href="#contact"
          class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 font-mono text-sm font-medium text-bg transition-colors hover:bg-accent-hover"
        >
          Contact Me
        </a>
        <a
          href="#projects"
          class="inline-flex items-center gap-2 rounded-lg border border-border px-5 py-2.5 font-mono text-sm font-medium text-text-secondary transition-all hover:border-accent hover:text-accent"
        >
          View Work
        </a>
      </div>
    </div>

    <!-- Profile image -->
    <div class="order-1 flex justify-center md:order-2">
      <div class="reveal reveal-scale relative">
        <div
          class="glow h-56 w-56 overflow-hidden rounded-full border-2 border-accent/30 md:h-72 md:w-72"
        >
          <img
            src="/profile-image.jpg"
            alt="Saladin"
            class="h-full w-full object-cover"
            loading="eager"
          />
        </div>
        <!-- Decorative ring -->
        <div
          class="absolute inset-0 -m-3 rounded-full border border-dashed border-accent/10"
        >
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce text-text-muted"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </div>
</section>
