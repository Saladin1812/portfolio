  {
    label: "GitHub",
    href: "https://github.com/Saladin1812",
    icon: `<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>`,
  },
  {
    label: "Twitter",
    href: "https://twitter.com/Saladin1812",
    icon: `<path d="M4 4l11.733 16H20L8.267 4z"/><path d="m4 20 6.768-6.768M15.232 10.768 20 4"/>`,
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/salahuddin-ayyub-852531352/",
    icon: `<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>`,
  },
  {
    label: "YouTube",
    href: "https://youtube.com/@SaladinDevLog",
    icon: `<path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/>`,
  },
  {
    label: "Discord",
    href: "https://discord.gg/khWNXDXQfQ",
    icon: `<path d="M9.09 9a3 3 0 0 0-2.83 2M12.91 9a3 3 0 0 1 2.83 2M7.5 15.5c1.5 1 3.5 1.5 4.5 1.5s3-0.5 4.5-1.5M19.73 5.06A17 17 0 0 0 15.5 4c-.2.4-.5 1-.7 1.4A16.5 16.5 0 0 0 9.2 5.4c-.2-.5-.4-1-.7-1.4a17 17 0 0 0-4.23 1.06C1.27 9.56.5 14 1 18.4A17.1 17.1 0 0 0 6.3 21a12 12 0 0 0 1.1-1.8 11 11 0 0 1-1.7-.8l.4-.3a12.2 12.2 0 0 0 10.4 0l.4.3a11 11 0 0 1-1.7.8 12 12 0 0 0 1.1 1.8A17.1 17.1 0 0 0 21.5 18.4c.5-5.3-.9-9.8-3.77-13.34Z"/>`,
  },
  {
    label: "Blog",
    href: "https://blog.saladin.pro",
    icon: `<path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/>`,
  },
